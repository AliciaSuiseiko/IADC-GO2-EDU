From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.invalid>
Date: Sat, 8 Aug 2026 02:12:00 +0800
Subject: [PATCH] sort Livox points by offset time before undistortion

Livox Mid-360 custom messages are not guaranteed to be strictly ordered by
offset_time. The FAST-LIO2 preprocessing path sorts the point cloud before
its backward undistortion loop; Elevator-LIO's ROS 2 path previously assumed
the incoming order was monotonic and could apply the wrong IMU pose interval.
---
 src/node/LidarPipeline.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/node/LidarPipeline.cpp b/src/node/LidarPipeline.cpp
index 0000000..0000000 100644
--- a/src/node/LidarPipeline.cpp
+++ b/src/node/LidarPipeline.cpp
@@ -11,5 +11,6 @@
 #include "ikd_tree/IkdMap.hpp"
 #include "AdaptiveFilter/AdaptiveVoxelPController.hpp"
 #include <pcl/filters/voxel_grid.h>
+#include <algorithm>
 #include <sstream>
 #include <iomanip>
@@ -170,5 +171,9 @@ bool LidarPipeline::undistortFrame(const FrameData& frame, State& lidar_end_state,
                                     PointCloudXYZI::Ptr& out_cloud) {
     *out_cloud = *frame.raw_cloud;
+    std::sort(out_cloud->points.begin(), out_cloud->points.end(),
+              [](const PointType& lhs, const PointType& rhs) {
+                  return lhs.curvature < rhs.curvature;
+              });
     if (exit_from_elevator_) return true;

     std::vector<Pose> imu_pose_vec;
--
