+def scan2pixels_go2_x5(laserCloud):
+    """Project the Go2/Mid-360 cloud into the cropped X5 panorama.
+
+    The FAST-LIO2 adapter expresses the cloud at the Mid-360 origin with axes
+    aligned to the Go2 body. The X5 optical center is 0.32 m behind and 0.31 m
+    above that origin. The panoramic axis convention is otherwise the same as
+    the upstream mecanum/Theta projection.
+    """
+    mecanum_camera_offset = np.array([-0.235, 0.0, 0.13])
+    go2_x5_camera_offset = np.array([-0.32, 0.0, 0.31])
+    offset_delta = mecanum_camera_offset - go2_x5_camera_offset
+
+    # scan2pixels_mecanum sorts laserCloud in place. Apply and then remove the
+    # translation on the same array so its point order stays aligned with the
+    # returned pixel indices.
+    laserCloud[:, :3] += offset_delta
+    try:
+        return scan2pixels_mecanum(laserCloud)
+    finally:
+        laserCloud[:, :3] -= offset_delta
+
